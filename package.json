{
  "name": "ai-command-center",
  "version": "0.1.0",
  "private": true,
  "description": "One window for the browser, PowerShell terminals, a sidebar over your project folders, and an agent harness.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "lint": "node scripts/lint.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "smoke": "node scripts/smoke.js",
    "demo": "node scripts/demo.js",
    "scan:secrets": "gitleaks git --no-banner --redact .",
    "spike:extensions": "node scripts/smoke.js https://www.bestbuy.com --install hdokiejnpimakedhajhdlcegeplioahd,chhjbpecpncaggjpdakmflnfcopglcmi"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-chrome-extensions": "^4.9.0",
    "electron-chrome-web-store": "^0.13.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^44.7.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
