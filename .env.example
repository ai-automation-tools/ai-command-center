# Copy to .env (gitignored) and fill in what you use, then restart the app.
# A variable set in the real environment wins over this file.

# Chat tab. ACC_CHAT_* rather than ANTHROPIC_*, so `claude` in a terminal keeps
# billing your subscription. No default model: the app never picks what you pay for.
ACC_CHAT_API_KEY=
ACC_CHAT_MODEL=

# Cron tab: the entry script in a Cronsole checkout, and its UI if not on :7373.
ACC_CRONSOLE_MCP=
# ACC_CRONSOLE_UI=http://localhost:7373
# CRONSOLE_TOKEN=
# CRONSOLE_API_URL=

# Project Hub, overriding hubUrl in %APPDATA%\ai-command-center\settings.json.
# ACC_HUB_URL=
# Hub's address must be on this machine (127.0.0.1, localhost, [::1]) unless this is 1.
# ACC_HUB_REMOTE=1
